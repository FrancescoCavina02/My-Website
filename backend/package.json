{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "uvicorn app.main:app --reload --port 8000",
    "start": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest",
    "test:cov": "pytest --cov=app --cov-report=html",
    "test:watch": "pytest-watch",
    "format": "black . && isort .",
    "format:check": "black --check . && isort --check-only .",
    "lint": "flake8 .",
    "type-check": "mypy app",
    "quality": "black --check . && isort --check-only . && flake8 . && mypy app"
  },
