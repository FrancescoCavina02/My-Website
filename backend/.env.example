# Backend Environment Variables
# Copy this file to .env and fill in your values

# Obsidian Vault Path
OBSIDIAN_VAULT_PATH=/Users/francescocavina/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian Books

# Server Settings
PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache Settings (in seconds)
CACHE_TTL=300

# Database Configuration
# For local development, use SQLite:
DATABASE_URL=sqlite:///./portfolio.db
# For production (Render PostgreSQL), use:
# DATABASE_URL=postgresql://user:password@host:port/database

# Authentication
# Generate a secure random secret key (use: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin Credentials
ADMIN_EMAIL=admin@example.com
# Generate hash with: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$example_hash_replace_with_real_hash

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key-here
NOTIFICATION_EMAIL=your-email@example.com
FROM_EMAIL=noreply@yourdomain.com
